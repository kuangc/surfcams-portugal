{
  "name": "surfcams-portugal",
  "version": "0.1.0",
  "description": "Ad-free personal Portugal surfcam viewer with map, favorites, and indexed Beachcam/MEO stream URLs.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/build-runtime-assets.js",
    "check:conditions": "node scripts/check-conditions-freshness.js",
    "probe:meo-signed": "node scripts/probe-meo-signed-streams.js",
    "verify": "npm run build && npm test && npm run check-spot-advice && npm run check:worker",
    "verify:fresh": "npm run verify && npm run check:conditions",
    "test:app": "node --test \"test/*.test.js\" \"test/worker/*.test.js\"",
    "test:worker": "npm run build && vitest run --config vitest.worker.config.js",
    "test": "npm run test:app && npm run test:worker",
    "check:worker": "wrangler deploy --dry-run --config wrangler.jsonc --secrets-file test/fixtures/wrangler-dry-run-secrets.env --outdir .wrangler/dry-run",
    "cf:bootstrap": "wrangler deploy --config wrangler.bootstrap.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "probe-surfline": "node scripts/probe-surfline-fetch.js",
    "embed-data": "node scripts/embed-camera-db.js",
    "build-pwa-icons": "node scripts/generate-pwa-icons.js",
    "build-surfline-spots": "node scripts/build-surfline-spots.js",
    "build-meo-surfline-matches": "node scripts/build-meo-surfline-matches.js",
    "build-spot-data": "node scripts/build-spot-data.js",
    "build-coast-exposures": "node scripts/build-coast-exposures.js",
    "build-spot-metadata-enrichment": "node scripts/build-spot-metadata-enrichment.js",
    "build-spot-advice": "node scripts/build-spot-advice.js",
    "build-spot-advice-review": "node scripts/build-spot-advice-review-html.js",
    "apply-spot-advice-feedback": "node scripts/apply-spot-advice-feedback.js",
    "check-spot-advice": "node scripts/build-spot-advice.js --check",
    "check-spot-advice-links": "node scripts/check-spot-advice-links.js",
    "build-surfline-needs-review": "node scripts/build-surfline-needs-review-html.js",
    "build-promoted-spots": "node scripts/build-promoted-spots.js",
    "build-promotion-map": "node scripts/build-promotion-map-html.js",
    "extract-surfline-conditions": "node scripts/extract-surfline-conditions.js",
    "refresh-surfline": "node scripts/refresh-surfline-conditions.js",
    "fetch-tides": "node scripts/fetch-tides.js",
    "cache-surfline": "node scripts/cache-surfline-pages.js",
    "cache-surfline-browser": "node scripts/cache-surfline-browser-cdp.js",
    "crawl": "node scripts/crawl-beachcam.cjs",
    "extract-feed": "node scripts/extract-beachcam-feed.cjs",
    "probe-surfline-browser": "node scripts/probe-surfline-browser.js"
  },
  "keywords": [
    "surf",
    "surfcam",
    "portugal",
    "beachcam",
    "hls"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "jose": "6.2.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuangc/surfcams-portugal.git"
  },
  "bugs": {
    "url": "https://github.com/kuangc/surfcams-portugal/issues"
  },
  "license": "MIT"
}
