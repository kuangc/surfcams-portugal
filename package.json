  "description": "Ad-free personal Portugal surfcam viewer with map, favorites, and indexed Beachcam/MEO stream URLs.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "test": "node --test \"test/*.test.js\"",
    "probe-surfline": "node scripts/probe-surfline-fetch.js",
    "embed-data": "node scripts/embed-camera-db.js",
    "build-pwa-icons": "node scripts/generate-pwa-icons.js",
    "build-surfline-spots": "node scripts/build-surfline-spots.js",
    "build-meo-surfline-matches": "node scripts/build-meo-surfline-matches.js",
    "build-spot-data": "node scripts/build-spot-data.js",
    "build-coast-exposures": "node scripts/build-coast-exposures.js",
    "build-spot-metadata-enrichment": "node scripts/build-spot-metadata-enrichment.js",
    "build-surfline-needs-review": "node scripts/build-surfline-needs-review-html.js",
